                })
                .fontSize(this.fontSize / 1.8) // ç»‘å®šå­—å·å˜é‡
                .fontWeight(this.fontWeight) // å­—ä½“ç²—ç»†
                .fontColor('#FFFFFF')
            }
            .width('100%')
