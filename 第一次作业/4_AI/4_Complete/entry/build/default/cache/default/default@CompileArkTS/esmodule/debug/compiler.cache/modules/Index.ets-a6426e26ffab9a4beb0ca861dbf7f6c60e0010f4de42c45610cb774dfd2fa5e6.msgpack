                .textOverflow({ overflow: TextOverflow.MARQUEE }) // TextOverflow.MARQUEEè¡¨ç¤ºTextç»„ä»¶çš„æ–‡å­—æº¢å‡ºä»¥è·‘é©¬ç¯æ¨¡å¼å¤„ç†
                // ç¬¬2æ­¥ï¼šé…ç½®æ»šåŠ¨çš„è§„åˆ™
                .marqueeOptions({
